{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
  "baseUrl": ".",
  "ignoreDeprecations": "6.0",
  "paths": {
    "@/*": ["./src/*"],
    "@stores/*": ["./src/stores/*"]
  },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules"]
}